      "video_kind": "human",
      "condition_asset": "video",
      "xclip_cache": "../models/video_motion_evaluator_human/xclip-base-patch32",
      "xclip_model_path": "../models/video_motion_evaluator_human/xclip-base-patch32",
      "video_condition_batch_size": 24,
      "video_decode_workers": 24,
      "xclip_window_batch_size": 128,
      "motion_qpos_batch_size": 512,
      "motion_window_batch_size": 4096
    },
    "video_motion_skel": {
      "factory": "scripts.evaluation.encoders.video_adapter:VideoMotionAdapter",
