    "text_motion": {
      "factory": "scripts.evaluation.encoders.text_adapter:TextMotionAdapter",
      "root": "text_motion_evaluator",
      "checkpoint": "../models/text_motion_evaluator/checkpoints/text_motion_evaluator.pt",
      "omg_root": "../third_party/OMG",
      "text_model_path": "../models/text_motion_evaluator/t5-base",
      "motion_key": "body_pos_local",
      "motion_fps": 30,
      "text_batch_size": 256
