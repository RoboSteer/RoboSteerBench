{
  "motion_encoder": {
    "type": "omg_motion",
    "checkpoint": "../models/motion_encoder/weights.pt",
    "architecture": "motion_encoder/model.py",
    "input_key": "body_pos_local",
    "flatten_features": true,
    "l2_normalize": false,
    "batch_size": 512
  },
  "cross_modal_evaluators": {
    "audio_motion": {
      "factory": "scripts.evaluation.encoders.audio_adapter:AudioMotionAdapter",
