      "omg_root": "../third_party/OMG",
      "omg_checkpoint": "../third_party/OMG/models/evaluator/step_004000.pt",
      "condition_asset": "raw_audio",
      "audio_chunk_batch_size": 2048,
      "motion_window_batch_size": 8192
    },
    "rhythm_motion": {
      "factory": "scripts.evaluation.encoders.cross_modal:RhythmMotionAdapter",
      "root": "rhythm_motion_evaluator",
      "checkpoint": "../models/rhythm_motion_evaluator/checkpoints/rhythm_motion_evaluator.pt",
      "omg_root": "../third_party/OMG",
      "omg_checkpoint": "../third_party/OMG/models/evaluator/step_004000.pt",
      "hf_home": "../models/rhythm_motion_evaluator/hf_cache",
      "condition_asset": "raw_audio",
      "audio_chunk_batch_size": 2048,
      "motion_window_batch_size": 8192
    },
    "trajectory_motion": {
      "factory": "scripts.evaluation.encoders.trajectory_adapter:TrajectoryMotionAdapter",
