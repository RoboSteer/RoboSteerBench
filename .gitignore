# Working notes and machine-specific examples are not public release files.
/*.md
!/README.md
!/README_PUBLIC.md
/*.tex
/*.json
/configs/models/
/evaluator_code/*/evaluation_results.json
/evaluator_code/*/tokenizer.json
/scripts/examples/*.sh
!/scripts/examples/run_level1.sh
!/scripts/examples/run_level2.sh
!/scripts/examples/run_level3.sh

# Publish the weight bundle separately, not in the GitHub code repository.
/evaluator_code/*/checkpoints/
/evaluator_code/*/model_cache/
/evaluator_code/*/hf_cache/
/evaluator_code/motion_encoder/weights.pt
/evaluator_code/text_motion_evaluator/model.safetensors
